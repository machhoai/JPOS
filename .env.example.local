# ==============================================================================
# POS System - Local environment template
# ==============================================================================
# Copy this file to `.env.local`. Next.js loads env files from the project root.
# Never commit `.env.local` or any service-account/private key.

# Firebase Client SDK
# Use the same six values as `D:\Github\bduck-system\.env.local` so both apps
# connect to the same Firebase Auth, Firestore, and Storage project.
NEXT_PUBLIC_FIREBASE_API_KEY="your_shared_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_shared_project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_shared_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_shared_storage_bucket"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_shared_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_shared_firebase_app_id"

# POS runtime configuration
NEXT_PUBLIC_SHOP_ID=1
# JPULSE backend used for one-time device enrollment and heartbeat/config sync.
NEXT_PUBLIC_JPULSE_API_URL="https://be-wms-107789134874.asia-southeast1.run.app"
# Public J-PULSE route prefix. The POS app appends the opaque request token.
NEXT_PUBLIC_INVOICE_REQUEST_BASE_URL="https://jpulse.joyworldcityfuns.vn/invoice-request"

# Firebase Admin credentials are intentionally not defined here.
# Deployed Cloud Functions use Application Default Credentials. Local emulators
# also do not require a service-account private key in this repository.

# Hong Kong API credentials are server-only. Configure them from
# `functions/.env.example`; never place them in this frontend env file.
