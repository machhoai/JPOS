rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // BEGIN POS PAYMENT REALTIME
    // Merge this block into the live shared ruleset; never deploy the POS-only
    // firestore.rules file over bduck-system's rules.
    function posPaymentWatchAllowed() {
      let status = resource.data;
      let actor = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let device = get(/databases/$(database)/documents/pos_devices/$(status.deviceId)).data;
      let warehouse = get(/databases/$(database)/documents/warehouses/$(status.warehouseId)).data;
      let access = get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data;
      return status.ownerUid == request.auth.uid
        && request.time < status.expiresAt
        && actor.status == 'ACTIVE' && actor.is_deleted == false
        && device.status == 'ACTIVE' && device.get('is_deleted', false) != true
        && device.warehouse_id == status.warehouseId
        && warehouse.status == 'ACTIVE' && warehouse.type == 'STORE' && warehouse.get('is_deleted', false) != true
        && access.is_deleted == false
        && access.active_version_id is string && access.active_version_id.size() > 0
        && (access.is_global_admin == true || posPaymentWatchGrant(access, status.warehouseId));
    }
    function posPaymentWatchGrant(access, warehouseId) {
      let grant = get(/databases/$(database)/documents/user_access/$(request.auth.uid)/versions/$(access.active_version_id)/facilities/$(warehouseId)).data;
      return grant.is_deleted == false
        && grant.user_id == request.auth.uid && grant.facility_id == warehouseId
        && grant.access_version_id == access.active_version_id && grant.access_version == access.access_version
        && (grant.permissions.get('pos.login', false) == true || grant.permissions.get('*', false) == true);
    }
    match /pos_payment_status/{subscriptionId} {
      allow get: if request.auth != null && posPaymentWatchAllowed();
      allow list, create, update, delete: if false;
    }
    match /pos_payment_checks/{orderCode} {
      allow read, write: if false;
    }
    // END POS PAYMENT REALTIME

    // POS orders and member profiles are backend-only. Authenticated clients
    // use callable Cloud Functions; only the Admin SDK reads or writes data.
    match /pos_orders/{orderId} {
      allow read, write: if false;
    }

    // Hồ sơ chỉnh sửa và lịch sử thử đồng bộ chỉ được truy cập qua backend.
    match /pos_member_profile_locks/{lockId} {
      allow read, write: if false;
    }

    match /pos_member_profile_changes/{operationId} {
      allow read, write: if false;
      match /attempts/{attemptId} {
        allow read, write: if false;
      }
    }

    // Import HK: metadata/hash manifests and run summaries are backend-only.
    match /pos_member_import_state/{stateId} { allow read, write: if false; }
    match /pos_member_import_runs/{runId} { allow read, write: if false; }

    match /pos_member_registration_requests/{registrationId} {
      allow read, write: if false;
      match /{document=**} { allow read, write: if false; }
    }
    match /pos_member_card_return_jobs/{jobId} {
      allow read, write: if false;
      match /{document=**} { allow read, write: if false; }
    }
    match /pos_member_card_locks/{lockId} { allow read, write: if false; }
    match /pos_members/{memberId} {
      allow read, write: if false;
      match /stored_value_renewals/{operationId} { allow read, write: if false; }
      match /stored_value_renewal_locks/{batchId} { allow read, write: if false; }
    }

    // Payment settings are managed exclusively by authenticated callable
    // Functions so account changes receive device-scoped RBAC checks.
    match /pos_payment_settings/{deviceId} {
      allow read, write: if false;
    }

    // Lucky-draw campaign settings are warehouse-scoped and are only read or
    // changed through authenticated callable Functions with POS RBAC checks.
    match /pos_lucky_draw_settings/{warehouseId} {
      allow read, write: if false;
    }

    // JPULSE manages trusted devices and shared receipt configuration through
    // authenticated backend APIs. JPOS never accesses these documents directly.
    match /pos_devices/{deviceId} {
      allow read, write: if false;
    }
    match /pos_product_sync_runs/{runId} {
      allow read, write: if false;
    }
    match /pos_device_enrollments/{enrollmentId} {
      allow read, write: if false;
    }
    match /pos_receipt_settings/{warehouseId} {
      allow read, write: if false;
    }
    match /pos_ticket_settings/{warehouseId} {
      allow read, write: if false;
    }
    // Voucher policy and redemption records are read and written only through
    // authenticated backends so redemption and order updates stay atomic.
    match /pos_voucher_campaign_settings/{settingId} {
      allow read, write: if false;
    }
    match /pos_voucher_redemptions/{redemptionId} {
      allow read, write: if false;
    }
  }
}
