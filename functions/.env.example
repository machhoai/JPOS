# Hong Kong API credentials - Firebase Cloud Functions only
# Copy this file to `.env.local` in the same directory and fill real values.
# Never prefix these variables with NEXT_PUBLIC_.
HK_API_APP_ID="your_hk_api_app_id"
HK_API_KEY="your_hk_api_key"
HK_API_BASE_URL="https://your-api-domain.example.com"
HK_API_VERSION="11.7.1"

# JoyWorld manager API credentials — required for authoritative souvenir
# `afterTaxPrice` data from /gift/manager/base/list.
JOYWORLD_USER="your_joyworld_manager_user"
JOYWORLD_PASS="your_joyworld_manager_password"
JPOS_PRODUCT_SYNC_SECRET="replace-with-a-long-random-shared-secret"
JOYWORLD_BASE_URL="http://joyworld.jingjianx.vip"

# PayOS credentials are server-only. In production, configure the three keys
# below with Firebase Secret Manager. Redirects use the configured JPOS base URL:
# https://jpos.joyworldcityfuns.vn/
PAYOS_CLIENT_ID="your_payos_client_id"
PAYOS_API_KEY="your_payos_api_key"
PAYOS_CHECKSUM_KEY="your_payos_checksum_key"

# Must match the shop bound to HK_API_APP_ID and frontend NEXT_PUBLIC_SHOP_ID.
HK_API_SHOP_ID=1

# Import-only endpoint; leaves existing order endpoint unchanged.
HK_MEMBER_IMPORT_BASE_URL=https://your-hk-host/openapi/action
MEMBER_IMPORT_ENABLED=false
